# ~/.zshrc.local (Plantilla de secretos y configuraciones específicas de esta máquina)
# Este archivo está ignorado en git (*.local).
# Copia este archivo a ~/.zshrc.local para variables privadas.

# Perfil activo de dotfiles para Agentes IA (work / personal)
# export DOTFILES_PROFILE="work"

# Plane Self-Hosted (Gestión de Tareas TI)
# export PLANE_BASE_URL="http://plane.example.com"
# export PLANE_API_KEY="plane_api_xxx"
# export PLANE_WORKSPACE_SLUG="mi-workspace"
# export PLANE_PROJECT_ID="<uuid-proyecto>" # Omnify

# Ejemplo de tokens o API keys privadas:
# export GITHUB_TOKEN="ghp_xxx"
# export OPENAI_API_KEY="sk-xxx"
# export ANTHROPIC_API_KEY="sk-ant-xxx"

# Preferencias de Zellij:
# export ZELLIJ_AUTO_START=false       # Desactiva auto-inicio de Zellij
# export ZELLIJ_AUTO_ATTACH=false      # Inicia sesión nueva en vez de conectarse a la existente
# export ZELLIJ_AUTO_EXIT=false        # Mantiene el shell abierto al salir de Zellij
# export ZELLIJ_AUTO_START_IDE=true    # Inicia Zellij también dentro de VS Code / Antigravity IDE

# Aliases específicos de este equipo:
# alias work-vpn="sudo openvpn /etc/openvpn/client.ovpn"

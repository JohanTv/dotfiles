# ==============================================================================
# Dotfiles Orchestrator & Multi-Profile Agent Builder
# ==============================================================================

SHELL := /usr/bin/env bash
DOTFILES_DIR := $(shell pwd)
PROFILE_FILE := $(DOTFILES_DIR)/.active-profile
PROFILE ?= $(shell cat $(PROFILE_FILE) 2>/dev/null || echo $${DOTFILES_PROFILE:-work})

DIST_DIR := $(DOTFILES_DIR)/agents/rules/dist
ACTIVE_RULES := $(DIST_DIR)/active-rules.md
CORE_RULES := $(DOTFILES_DIR)/agents/rules/src/core.md
PROFILE_RULES := $(DOTFILES_DIR)/agents/rules/src/$(PROFILE).md

IS_WSL := $(shell grep -qiE "(microsoft|wsl)" /proc/version 2>/dev/null && echo true || echo false)

.PHONY: all work personal compile-rules link-rules sync-skills sync-binaries doctor check install help

all: compile-rules link-rules sync-skills sync-binaries
	@echo "✔ Dotfiles sincronizados con perfil activo: [$(PROFILE)] (WSL: $(IS_WSL))"

work:
	@echo "work" > $(PROFILE_FILE)
	@$(MAKE) PROFILE=work all

personal:
	@echo "personal" > $(PROFILE_FILE)
	@$(MAKE) PROFILE=personal all

compile-rules:
	@mkdir -p $(DIST_DIR)
	@if [ ! -f "$(CORE_RULES)" ]; then echo "Error: Falta $(CORE_RULES)"; exit 1; fi
	@if [ ! -f "$(PROFILE_RULES)" ]; then echo "Error: Perfil '$(PROFILE)' no existe en src/"; exit 1; fi
	@# Liberar permisos si existía archivo previo
	@chmod u+w $(ACTIVE_RULES) 2>/dev/null || true
	@echo "<!-- ===================================================================== -->" > $(ACTIVE_RULES)
	@echo "<!-- AUTO-GENERATED BY MAKEFILE - DO NOT EDIT DIRECTLY                    -->" >> $(ACTIVE_RULES)
	@echo "<!-- Active Profile: $(PROFILE) | Built: $$(date) -->" >> $(ACTIVE_RULES)
	@echo "<!-- Edit sources in agents/rules/src/ and run 'make'                     -->" >> $(ACTIVE_RULES)
	@echo "<!-- ===================================================================== -->" >> $(ACTIVE_RULES)
	@echo "" >> $(ACTIVE_RULES)
	@cat $(CORE_RULES) >> $(ACTIVE_RULES)
	@echo "" >> $(ACTIVE_RULES)
	@cat $(PROFILE_RULES) >> $(ACTIVE_RULES)
	@chmod 444 $(ACTIVE_RULES)
	@echo "✔ Reglas compiladas en $(ACTIVE_RULES) [modo solo lectura]"

link-rules: compile-rules
	@mkdir -p $$HOME/.gemini $$HOME/.claude $$HOME/.config/opencode
	@ln -sf $(ACTIVE_RULES) $$HOME/.gemini/GEMINI.md
	@ln -sf $(ACTIVE_RULES) $$HOME/.claude/CLAUDE.md
	@ln -sf $(ACTIVE_RULES) $$HOME/.config/opencode/AGENTS.md
	@echo "✔ Symlinks de agentes actualizados a active-rules.md"

sync-skills:
	@mkdir -p $$HOME/.agents/skills
	@# 1. Enlazar skills comunes
	@for d in $(DOTFILES_DIR)/agents/skills/common/*; do \
		if [ -d "$$d" ]; then \
			ln -sfn "$$d" "$$HOME/.agents/skills/$$(basename "$$d")"; \
		fi \
	done
	@# 2. Enlazar desktop-linux (solo si no es WSL)
	@if [ "$(IS_WSL)" = "false" ]; then \
		for d in $(DOTFILES_DIR)/agents/skills/desktop-linux/*; do \
			if [ -d "$$d" ]; then \
				ln -sfn "$$d" "$$HOME/.agents/skills/$$(basename "$$d")"; \
			fi \
		done \
	fi
	@# 3. Enlazar skills de trabajo si perfil es work
	@if [ "$(PROFILE)" = "work" ]; then \
		for d in $(DOTFILES_DIR)/agents/skills/work/*; do \
			if [ -d "$$d" ]; then \
				ln -sfn "$$d" "$$HOME/.agents/skills/$$(basename "$$d")"; \
			fi \
		done \
	fi
	@# 4. Poda segura: limpiar symlinks obsoletos o inactivos que apunten a dotfiles
	@for link in $$HOME/.agents/skills/*; do \
		if [ -L "$$link" ]; then \
			target=$$(readlink -f "$$link" 2>/dev/null || true); \
			base=$$(basename "$$link"); \
			case "$$target" in \
				$(DOTFILES_DIR)/agents/skills/*) \
					# Si es de trabajo pero no estamos en work, remover \
					if [ "$$target" = "$(DOTFILES_DIR)/agents/skills/work/$$base" ] && [ "$(PROFILE)" != "work" ]; then \
						rm "$$link"; \
						echo "○ Poda de skill de trabajo inactiva: $$base"; \
					fi; \
					# Si es desktop pero estamos en WSL, remover \
					if [ "$$target" = "$(DOTFILES_DIR)/agents/skills/desktop-linux/$$base" ] && [ "$(IS_WSL)" = "true" ]; then \
						rm "$$link"; \
						echo "○ Poda de skill desktop en WSL: $$base"; \
					fi; \
					# Si el destino no existe (broken link post-migración), remover \
					if [ ! -e "$$target" ]; then \
						rm "$$link"; \
						echo "○ Poda de symlink roto: $$base"; \
					fi; \
					;; \
			esac \
		fi \
	done
	@echo "✔ Sincronización y conciliación de skills completada."

sync-binaries:
	@mkdir -p $$HOME/.local/bin
	@# 1. Enlazar binarios comunes
	@for b in $(DOTFILES_DIR)/bin/common/*; do \
		if [ -f "$$b" ]; then \
			chmod +x "$$b"; \
			ln -sf "$$b" "$$HOME/.local/bin/$$(basename "$$b")"; \
		fi \
	done
	@# 2. Enlazar desktop-linux (solo si no es WSL)
	@if [ "$(IS_WSL)" = "false" ] && [ -d "$(DOTFILES_DIR)/bin/desktop-linux" ]; then \
		for b in $(DOTFILES_DIR)/bin/desktop-linux/*; do \
			if [ -f "$$b" ]; then \
				chmod +x "$$b"; \
				ln -sf "$$b" "$$HOME/.local/bin/$$(basename "$$b")"; \
			fi \
		done \
	fi
	@# 3. Enlazar binarios de trabajo si perfil es work
	@if [ "$(PROFILE)" = "work" ] && [ -d "$(DOTFILES_DIR)/bin/work" ]; then \
		for b in $(DOTFILES_DIR)/bin/work/*; do \
			if [ -f "$$b" ]; then \
				chmod +x "$$b"; \
				ln -sf "$$b" "$$HOME/.local/bin/$$(basename "$$b")"; \
			fi \
		done \
	fi
	@# 4. Poda segura de binarios obsoletos o inactivos
	@for link in $$HOME/.local/bin/*; do \
		if [ -L "$$link" ]; then \
			target=$$(readlink -f "$$link" 2>/dev/null || true); \
			base=$$(basename "$$link"); \
			case "$$target" in \
				$(DOTFILES_DIR)/bin/*) \
					# Si es de trabajo pero no estamos en work, remover \
					if [ "$$target" = "$(DOTFILES_DIR)/bin/work/$$base" ] && [ "$(PROFILE)" != "work" ]; then \
						rm "$$link"; \
						echo "○ Poda de binario de trabajo inactivo: $$base"; \
					fi; \
					# Si es desktop pero estamos en WSL, remover \
					if [ "$$target" = "$(DOTFILES_DIR)/bin/desktop-linux/$$base" ] && [ "$(IS_WSL)" = "true" ]; then \
						rm "$$link"; \
						echo "○ Poda de binario desktop en WSL: $$base"; \
					fi; \
					# Si el destino no existe (broken link), remover \
					if [ ! -e "$$target" ]; then \
						rm "$$link"; \
						echo "○ Poda de binario roto: $$base"; \
					fi; \
					;; \
			esac \
		fi \
	done
	@echo "✔ Sincronización y conciliación de binarios completada."

doctor:
	@python3 $(DOTFILES_DIR)/bin/common/dotfiles-doctor

check: doctor

install:
	@./install.sh

help:
	@echo "Uso del Makefile de Dotfiles:"
	@echo "  make              Compila perfil activo ($(PROFILE)) y concilia symlinks"
	@echo "  make work         Activa perfil de trabajo (Plane + Omnify) y compila"
	@echo "  make personal     Activa perfil personal limpio"
	@echo "  make doctor       Ejecuta dotfiles-doctor para auditar integridad"
	@echo "  make install      Ejecuta instalador completo"

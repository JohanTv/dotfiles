#!/usr/bin/env bash
# plane-worktree - Relevo a motor nativo Allostasis en Go (alo-ws)
# Mantiene retrocompatibilidad para scripts y agentes ejecutando el binario Go en <5ms.

if command -v alo-ws >/dev/null 2>&1; then
    exec alo-ws "$@"
elif [[ -x "$HOME/.local/bin/alo-ws" ]]; then
    exec "$HOME/.local/bin/alo-ws" "$@"
else
    echo "Error: alo-ws no encontrado en PATH ni en ~/.local/bin/alo-ws" >&2
    exit 1
fi

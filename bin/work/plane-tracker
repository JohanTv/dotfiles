#!/usr/bin/env bash
# plane-tracker - Relevo a motor nativo Allostasis en Go (plane-tracker-bin / alo ticket)
# Mantiene retrocompatibilidad total para scripts y agentes ejecutando Go en <5ms sin Python.

if command -v plane-tracker-bin >/dev/null 2>&1; then
    exec plane-tracker-bin "$@"
elif [[ -x "$HOME/.local/bin/plane-tracker-bin" ]]; then
    exec "$HOME/.local/bin/plane-tracker-bin" "$@"
elif command -v alo >/dev/null 2>&1; then
    case "$1" in
        list|search|get|create|update|whoami)
            exec alo ticket "$@"
            ;;
        agenda)
            exec alo agenda "${@:2}"
            ;;
        sync)
            exec alo ticket sync "${@:2}"
            ;;
        *)
            exec alo ticket "$@"
            ;;
    esac
elif [[ -x "$HOME/.local/bin/alo" ]]; then
    case "$1" in
        list|search|get|create|update|whoami)
            exec "$HOME/.local/bin/alo" ticket "$@"
            ;;
        agenda)
            exec "$HOME/.local/bin/alo" agenda "${@:2}"
            ;;
        sync)
            exec "$HOME/.local/bin/alo" ticket sync "${@:2}"
            ;;
        *)
            exec "$HOME/.local/bin/alo" ticket "$@"
            ;;
    esac
else
    echo "Error: alo ni plane-tracker-bin encontrados en PATH ni en ~/.local/bin" >&2
    exit 1
fi
